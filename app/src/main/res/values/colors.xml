<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Gaming / Productivity tab system. Deliberately grayscale — white,
         gray, dark gray — as an homage to stock Moonlight rather than a new
         brand palette. See BRAINSTORM.md for the design reasoning. -->
    <!-- Base panel gray (homage tone) is #2B2B2B, ~17% lightness. Gaming and
         Productivity each shift 10% of the 0-255 range off that base, in
         opposite directions, rather than using a flat color for both. -->
    <color name="ml_bg_panel_gaming">#111111</color>
    <color name="ml_bg_panel_productivity">#454545</color>
    <color name="ml_surface">#383838</color>

    <color name="ml_text_primary">#F2F2F2</color>
    <color name="ml_text_dim">#B5B5B5</color>
    <color name="ml_text_faint">#7D7D7D</color>

    <color name="ml_pill_active">#FFFFFF</color>
    <color name="ml_pill_active_text">#202020</color>
</resources>
