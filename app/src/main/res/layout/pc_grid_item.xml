<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <!-- Rounded card, matching the same corner-radius/ml_surface convention
         already used for panels elsewhere in the app (see bg_drawer_panel) -
         just applied to a grid tile instead of a bottom sheet.
         duplicateParentState (NOT focusable="true" - that steals the click
         from the GridView's own OnItemClickListener before it ever reaches
         it) makes the selector's pressed/focused states track whatever the
         actual list item's real focus/press state is. Size kept in sync
         with dimens.xml's pc_card_column_width/pc_card_row_height
         (200+14*2, 210+14*2) - update both together if this changes. -->
    <RelativeLayout
        android:id="@+id/grid_card"
        android:layout_width="200dp"
        android:layout_height="210dp"
        android:background="@drawable/bg_pc_card_selector"
        android:duplicateParentState="true"
        android:padding="18dp">

        <RelativeLayout
            android:id="@+id/grid_image_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="6dp">
            <ImageView
                android:id="@+id/grid_image"
                android:layout_centerHorizontal="true"
                android:layout_width="94dp"
                android:layout_height="94dp">
            </ImageView>
            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="21dp"
                android:layout_width="38dp"
                android:layout_height="38dp">
            </ImageView>
            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="21dp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:indeterminate="true">
            </ProgressBar>
        </RelativeLayout>

        <TextView
            android:id="@+id/grid_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/grid_image_layout"
            android:layout_marginTop="14dp"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:textColor="@color/ml_text_primary"
            android:textSize="15sp" >
        </TextView>

        <!-- Long-press (2s) toggles this. Hidden by default - see
             PcGridAdapter.populateView(). -->
        <ImageView
            android:id="@+id/grid_favorite"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="10dp"
            android:src="@drawable/ic_favorite_star"
            android:visibility="gone">
        </ImageView>
    </RelativeLayout>
</RelativeLayout>
